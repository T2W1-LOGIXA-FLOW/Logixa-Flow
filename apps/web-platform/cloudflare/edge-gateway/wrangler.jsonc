{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logixa-flow-edge-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-05",
  "vars": {
    "UPSTREAM_API": "https://logixa-flow-api.onrender.com",
    "ALLOWED_ORIGIN": "https://logixa-flow.vercel.app",
    "ENVIRONMENT": "production"
  }
  // SECURITY: GATEWAY_SECRET must be set via: wrangler secret put GATEWAY_SECRET
  // NEVER put secrets in vars — they are exposed in Cloudflare dashboard and git history.
  // Current key is COMPROMISED — rotate it immediately at https://dash.cloudflare.com
}
